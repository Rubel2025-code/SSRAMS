# SSRAMS v3.1 — environment variable template.
#
# Copy this file to `.env` (which is gitignored) and fill in real
# values. Never commit `.env` itself. See README.md "Environment
# Variables" for a full explanation of each setting.

# --- Django core -------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_LOG_LEVEL=INFO

# Set to True and configure the block below when deploying behind HTTPS.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# --- Database ------------------------------------------------------------
# DB_ENGINE selects which Django DATABASES config is used
# (see config/settings.py):
#   mssql                 -> Microsoft SQL Server (INTENDED / DEFAULT — SRS §2.1.3)
#   sqlite_dev_fallback   -> TEMPORARY local-only fallback, see README.md
DB_ENGINE=mssql

DB_NAME=ssrams
DB_USER=ssrams_app
DB_PASSWORD=replace-with-a-real-password
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes;Encrypt=yes

# --- Session -------------------------------------------------------------
SESSION_COOKIE_AGE_SECONDS=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# --- Gemini API (SRS §2.1.1) ----------------------------------------------
# Server-side only — never expose this key to the frontend. Leave blank
# to run with AI features disabled; deterministic features (search,
# eligibility, recommendation, readiness, prioritization, applications)
# keep working per SRS §2.5.
#
# GEMINI_MODEL_NAME must be a model your key is actually entitled to.
# The catalog (client.models.list()) advertises models a given key/tier
# cannot call, and the failure only shows up at request time:
#   404 NOT_FOUND         -> retired, or not enabled for this key
#   429 RESOURCE_EXHAUSTED-> no quota on this tier
#   503 UNAVAILABLE       -> model saturated
# Verified reachable on 2026-08-31: gemini-3.6-flash, gemini-3.5-flash.
# Leave blank to accept the project default in config/settings.py.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# Hard bound on a single Gemini request (seconds). A real answer has been
# measured at 60s+, so leave headroom. Any WSGI server timeout must be
# LARGER than this (gunicorn's default 30s is too low: use
# `gunicorn --timeout 120`).
GEMINI_TIMEOUT_SECONDS=90
